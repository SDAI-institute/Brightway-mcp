  {
   "cell_type": "markdown",
   "id": "04cca016",
   "metadata": {},
   "source": [
    "## Decompose GWP per scenario (calcination / combustion / electricity)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "9b55ca86",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-07-12T17:20:26.000574Z",
     "iopub.status.busy": "2026-07-12T17:20:25.999940Z",
     "iopub.status.idle": "2026-07-12T17:20:26.019815Z",
     "shell.execute_reply": "2026-07-12T17:20:26.018647Z"
    }
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "          calcination  combustion  electricity   total\n",
      "baseline       0.4770      0.2938       0.0462  0.8170\n",
      "alt_fuel       0.4770      0.1542       0.0462  0.6774\n",
      "ccs            0.0716      0.0245       0.0560  0.1520"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "\n"
     ]
    }
   ],
   "source": [
    "def decompose(col):\n",
    "    p = scen[col]\n",
    "    calc = p[\"clinker_ratio\"] * p[\"calcination_co2\"]\n",
    "    comb = (p[\"clinker_ratio\"] * p[\"fuel_energy\"] *\n",
    "            (p[\"coal_share\"] * p[\"coal_ci\"] + (1 - p[\"coal_share\"]) * p[\"altfuel_ci\"]))\n",
    "    elec = p[\"elec_use\"] * p[\"grid_ci\"]\n",
    "    captured = p[\"ccs_capture\"] * (calc + comb)\n",
    "    # CCS captures a fraction of calcination+combustion; electricity is the penalty\n",
    "    calc_net = calc * (1 - p[\"ccs_capture\"])\n",
    "    comb_net = comb * (1 - p[\"ccs_capture\"])\n",
    "    return {\"calcination\": calc_net, \"combustion\": comb_net, \"electricity\": elec}\n",
    "\n",
    "decomp = pd.DataFrame({c: decompose(c) for c in SCEN_COLS}).T\n",
    "decomp[\"total\"] = decomp.sum(axis=1)\n",
    "print(decomp.round(4).to_string())"
   ]
  },
