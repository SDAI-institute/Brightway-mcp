     "output_type": "stream",
     "text": [
      "\n"
     ]
    }
   ],
   "source": [
    "scen = pd.read_csv(Path.cwd() / \"data\" / \"cement_scenarios.csv\").set_index(\"parameter\")\n",
    "print(scen.to_string())\n",
    "SCEN_COLS = [\"baseline\", \"alt_fuel\", \"ccs\"]"
   ]
