   "source": [
    "from pathlib import Path\n",
    "import openpyxl\n",
    "import bw2data as bd\n",
    "import bw2io as bi\n",
    "import bw2calc as bc\n",
    "\n",
    "bd.projects.set_current(\"bw25-tutorials\")\n",
    "BIOSPHERE = next(d for d in bd.databases if \"biosphere\" in d.lower())"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "ba2331f8",
   "metadata": {},
   "source": [
    "## 1. Generate an Excel foreground template\n",
    "We write it into the repo's `data/` folder so it is reusable and inspectable."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "ea107be2",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-07-12T17:16:22.856116Z",
     "iopub.status.busy": "2026-07-12T17:16:22.855736Z",
     "iopub.status.idle": "2026-07-12T17:16:22.902743Z",
     "shell.execute_reply": "2026-07-12T17:16:22.901800Z"
    }
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "wrote"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      " "
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "kettle_import.xlsx"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "\n"
     ]
    }
   ],
   "source": [
    "data_dir = Path.cwd().parent / \"data\"\n",
    "data_dir.mkdir(exist_ok=True)\n",
    "xlsx_path = data_dir / \"kettle_import.xlsx\"\n",
    "\n",
    "wb = openpyxl.Workbook()\n",
    "ws = wb.active\n",
    "ws.title = \"inventory\"\n",
    "# NOTE: each Activity block carries an explicit `type: process` row. Without it\n",
    "# the importer cannot link the self-referencing `production` edge, and every\n",
    "# activity shows up unlinked. This is the #1 Excel-import gotcha.\n",
    "rows = [\n",
    "    [\"Database\", \"t04_kettle_xl\"], [],\n",
    "    [\"Activity\", \"electricity production, coal\"],\n",
    "    [\"unit\", \"kilowatt hour\"],\n",
    "    [\"type\", \"process\"],\n",
    "    [\"Exchanges\"],\n",
    "    [\"name\", \"amount\", \"unit\", \"database\", \"type\", \"categories\"],\n",
    "    [\"electricity production, coal\", 1.0, \"kilowatt hour\", \"t04_kettle_xl\", \"production\", \"\"],\n",
    "    [\"Carbon dioxide, fossil\", 0.95, \"kilogram\", BIOSPHERE, \"biosphere\", \"air\"],\n",
    "    [],\n",
    "    [\"Activity\", \"steel production\"],\n",
    "    [\"unit\", \"kilogram\"],\n",
    "    [\"type\", \"process\"],\n",
    "    [\"Exchanges\"],\n",
    "    [\"name\", \"amount\", \"unit\", \"database\", \"type\", \"categories\"],\n",
    "    [\"steel production\", 1.0, \"kilogram\", \"t04_kettle_xl\", \"production\", \"\"],\n",
    "    [\"electricity production, coal\", 2.9, \"kilowatt hour\", \"t04_kettle_xl\", \"technosphere\", \"\"],\n",
    "    [\"Carbon dioxide, fossil\", 1.9, \"kilogram\", BIOSPHERE, \"biosphere\", \"air\"],\n",
    "    [],\n",
    "    [\"Activity\", \"kettle assembly\"],\n",
    "    [\"unit\", \"unit\"],\n",
    "    [\"type\", \"process\"],\n",
    "    [\"Exchanges\"],\n",
    "    [\"name\", \"amount\", \"unit\", \"database\", \"type\", \"categories\"],\n",
    "    [\"kettle assembly\", 1.0, \"unit\", \"t04_kettle_xl\", \"production\", \"\"],\n",
    "    [\"steel production\", 1.2, \"kilogram\", \"t04_kettle_xl\", \"technosphere\", \"\"],\n",
    "]\n",
    "for r in rows:\n",
    "    ws.append(r)\n",
    "wb.save(xlsx_path)\n",
    "print(\"wrote\", xlsx_path.name)"
   ]
  },
